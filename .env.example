# ========================================
# Rogue Soldiers Framework
# Environment Configuration
# ========================================

# Optional. Reserved for deployment tooling and future runtime behavior.
# The current framework does not branch on NODE_ENV.
NODE_ENV=development

# Optional. Set to any value to disable ANSI terminal colors.
# NO_COLOR=1

# ========================================
# Discord Provider - required
# ========================================

# Discord bot token. Keep this secret and never commit a real value.
DISCORD_TOKEN=

# Discord application/client ID. Required for Discord startup and slash-command registration.
DISCORD_CLIENT_ID=

# ========================================
# Website Authentication - conditional
# ========================================

# Required only when config/providers/website.json has both:
#   "enabled": true
#   "authentication": { "enabled": true }
# Keep this secret and never commit a real value.
DISCORD_CLIENT_SECRET=

# ========================================
# 7 Days to Die Provider - conditional
# ========================================

# Required only when config/providers/sevendaystodie.json has "enabled": true.
# Keep this secret and never commit a real value.
SEVEN_DAYS_TO_DIE_TELNET_PASSWORD=
